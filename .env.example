# Copy to .env and fill in. Never commit .env.

# vLLM on AMD Developer Cloud (OpenAI-compatible)
VLLM_BASE_URL="http://<amd-gpu-instance-ip>:8000/v1"
VLLM_API_KEY=change-me
VLLM_MODEL=Qwen/Qwen3-32B
VLLM_ENABLE_THINKING=false

# Which agent runs the plan: local (our loop on vLLM) or evolus
AGENT_BACKEND=local

# Evolus (OpenAI-compatible endpoint of the workspace)
EVOLUS_BASE_URL="https://<evolus-api-base>/v1"
EVOLUS_API_KEY=change-me
EVOLUS_AGENT_ID=change-me

# Mock factory systems (inside docker compose: http://mocks:8000)
MOCKS_URL=http://localhost:8000

# MCP server: require this bearer token (set it whenever the server is public)
MCP_API_TOKEN=

# Public HTTPS host for docker compose --profile public (a domain, or <server-ip>.sslip.io)
PUBLIC_HOST=
