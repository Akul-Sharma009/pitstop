# Copy to .env and fill in. Never commit .env.

# The agent's model (OpenAI-compatible): AMD's Token Factory by default (key: notebooks.amd.com/tokenfactory).
# Self-hosted instead (deploy/vllm/serve.sh on an AMD MI300X): VLLM_BASE_URL=http://<gpu-ip>:8080/v1,
# VLLM_API_KEY=<the key serve.sh started with>, VLLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507 (or a Gemma 4 preset).
VLLM_PORT=8080
VLLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
VLLM_API_KEY=change-me
VLLM_MODEL=Gemma-4-31B-IT
VLLM_ENABLE_THINKING=false
LLM_NO_THINK=false

# Which agent runs the plan: local (our loop on vLLM) or evolus
AGENT_BACKEND=local

# Evolus (OpenAI-compatible endpoint of the workspace)
# Agent chat: Authorization: Bearer <application API key>. EVOLUS_AGENT_ID is "<applicationId>:<agentId>"
# (python scripts/evolus_check.py lists them). EVOLUS_BASE_URL defaults to https://api.evolus.ai/v1.
EVOLUS_API_KEY=change-me
EVOLUS_AGENT_ID="<applicationId>:<agentId>"

# Downtime saved (stated assumptions shown to the operator; see docs/contracts.md AgentResult.downtime)
UNPLANNED_DOWNTIME_H=8
DOWNTIME_COST_PER_H=500
DOWNTIME_CURRENCY=SGD

# Mock factory systems (inside docker compose: http://mocks:8000)
MOCKS_URL=http://localhost:8000

# Detector replay (stated assumptions; see README "About the data")
CUTTING_MIN_PER_DAY=20
ALERT_HORIZON_MIN=45
WEAR_LIMIT_WINDOW=3
ALERT_URL=http://localhost:8002/incidents

# MCP server: require this bearer token (set it whenever the server is public)
MCP_API_TOKEN=

# Public HTTPS host for docker compose --profile public (a domain, or <server-ip>.sslip.io)
PUBLIC_HOST=

# Where Caddy (--profile public) finds the model: default vLLM on this machine. On a small always-on VM in front
# of the GPU instance: MODEL_UPSTREAM=<gpu-ip>:8080 (and VLLM_BASE_URL=http://<gpu-ip>:8080/v1 for the agent)
MODEL_UPSTREAM=

# Screens login (the screens can approve orders): set a password whenever they are reachable from the internet
SCREENS_USER=manager
SCREENS_PASSWORD=

# Evolus backup agent (optional): a copy of the agent on another model. If the main agent's model can't be
# reached (or Evolus doesn't answer within EVOLUS_TIMEOUT_S), an alert whose run drafted nothing is planned on it.
EVOLUS_FALLBACK_AGENT_ID=
EVOLUS_AGENT_MODEL=Gemma 4 31B
EVOLUS_FALLBACK_MODEL=Qwen3.8-27B
EVOLUS_TIMEOUT_S=240
